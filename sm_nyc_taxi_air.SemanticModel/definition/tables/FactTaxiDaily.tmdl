table FactTaxiDaily
	lineageTag: 7e3f0d99-4562-4a45-959c-f2425e49cd70
	sourceLineageTag: [dbo].[FactTaxiDaily]

	measure 'Avg Fare USD' = DIVIDE(SUM(FactTaxiDaily[revenue_usd]),SUM(FactTaxiDaily[trips_count]))
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 943cf02e-6e9f-4a55-9776-766bfb6de775

		changedProperty = Name

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Revenue USD' = SUM(FactTaxiDaily[revenue_usd])
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 047938dd-d6b2-432a-b997-a6ff370e6a14

		changedProperty = Name

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Revenue EUR' = SUMX(FactTaxiDaily, FactTaxiDaily[revenue_usd]/RELATED(DimFX[usd_per_eur]))
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		lineageTag: 599e33da-c0be-4b10-85c1-5d1d3e54fc19

		changedProperty = Name

		changedProperty = FormatString

